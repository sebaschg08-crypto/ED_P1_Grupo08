<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <!-- pantalla principal -->
    <TextView
        android:id="@+id/Titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_juego"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.022" />

    <TextView
        android:id="@+id/ElegirSimbolo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="372dp"
        android:text="@string/seleccionar_simbolo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnO"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="108dp"
        android:text="@string/o"
        app:layout_constraintStart_toEndOf="@+id/btnX"
        tools:layout_editor_absoluteY="419dp" />

    <Button
        android:id="@+id/btnX"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/x"
        tools:layout_editor_absoluteX="49dp"
        tools:layout_editor_absoluteY="419dp" />

    <TextView
        android:id="@+id/elegirComienzo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/seleccionar_inicio"
        tools:layout_editor_absoluteX="149dp"
        tools:layout_editor_absoluteY="503dp" />

    <Button
        android:id="@+id/btonHumano"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/humano"
        tools:layout_editor_absoluteX="269dp"
        tools:layout_editor_absoluteY="552dp" />

    <Button
        android:id="@+id/btnComputador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/computadora"
        tools:layout_editor_absoluteX="49dp"
        tools:layout_editor_absoluteY="552dp" />

    <Button
        android:id="@+id/btonJugar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/jugar"
        tools:layout_editor_absoluteX="161dp"
        tools:layout_editor_absoluteY="632dp" />

    <TextView
        android:id="@+id/seleccionModo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/seleccionarModo"
        tools:layout_editor_absoluteX="116dp"
        tools:layout_editor_absoluteY="144dp" />

    <Button
        android:id="@+id/btnHvsPC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/modoHvsPC"
        tools:layout_editor_absoluteX="100dp"
        tools:layout_editor_absoluteY="186dp" />

    <Button
        android:id="@+id/btnPCvsPC"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/modoPCvsPC"
        tools:layout_editor_absoluteX="84dp"
        tools:layout_editor_absoluteY="234dp" />

    <Button
        android:id="@+id/btnHvsH"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/modoHvsH"
        tools:layout_editor_absoluteX="116dp"
        tools:layout_editor_absoluteY="282dp" />

    <Button
        android:id="@+id/btonCargar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cargar"
        tools:layout_editor_absoluteX="136dp"
        tools:layout_editor_absoluteY="62dp" />

</androidx.constraintlayout.widget.ConstraintLayout>